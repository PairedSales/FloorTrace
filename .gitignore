# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.cursor
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local settings
.claude/settings.local.json

# Claude Code worktrees. Each is a full checkout of this repo living inside it;
# git must never see them as content. Also excluded in .git/info/exclude on the
# machine they were created on, but that is not portable — this is.
.claude/worktrees/

# Tesseract training data downloaded by Node benchmark runs
eng.traineddata

# Python bytecode caches (embed absolute source paths — keep out of git)
__pycache__/
*.pyc

# Local scratch/debug scripts (may hardcode local paths)
scripts/_*.mjs

# Perf-probe copies of pipeline sources (instrumented forks, not sources)
.ocrperf/
.perfprobe/

# One-off audit/analysis write-ups kept locally. They are snapshots of a
# particular commit and go stale the moment the code moves — docs/ is for
# the ones worth maintaining.
*-Audit.md

# Real-world appraisal order artifacts (never commit)
cmp-vendors.*
